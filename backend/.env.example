# Copy to .env and replace the MongoDB URI with your development database URI.
# Future transaction paths require a replica set or supported managed cluster.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/replace_with_your_database?replicaSet=rs0
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_64_random_hex_characters
APP_ORIGIN=http://localhost:5173
